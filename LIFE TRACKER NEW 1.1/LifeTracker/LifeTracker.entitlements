<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: allow Apple Calendar (EventKit) access on the Mac -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Shared container with the widgets -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pranavpande.LifeTracker</string>
	</array>
	<!-- Files you pick yourself: drops, Save a Copy…, and the file pickers
	     web pages put up (GitHub's "Upload a photo", JUNO's assignment upload) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
