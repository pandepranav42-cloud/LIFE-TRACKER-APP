# Anything holding a real API key. Never commit these — GitHub's push
# protection will refuse the push, and a key in a repo is a key anyone with
# the repo has.
Secrets.xcconfig
Secrets.plist
*.secrets.plist
.env

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
.DS_Store

# The SIH submission decks. They carry six students' full names and enrolment
# numbers on the title page, and this repository is public — so they stay out
# of git unless the team decides otherwise.
LifeTracker-SIH*.pptx
LifeTracker-SIH*.pdf
