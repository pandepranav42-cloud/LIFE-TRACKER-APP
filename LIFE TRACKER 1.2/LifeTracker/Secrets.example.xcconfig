// Copy this to `Secrets.xcconfig` (which git ignores) and put your own key in.
//
// Then in Xcode: select the LifeTracker *project* → Info → Configurations →
// set both Debug and Release to use Secrets.xcconfig. The value lands in the
// built Info.plist as GeminiAPIKey, and LifeAI.bundledAPIKey reads it there.
//
// Leave it out entirely and the app starts with no key: Settings → Life AI
// asks for one, and that one lives in the Keychain instead.

INFOPLIST_KEY_GeminiAPIKey = PUT-YOUR-GEMINI-KEY-HERE
